{
    "model": {
        "type": "minecraft:select",
        "property": "minecraft:custom_model_data",
        "fallback": {
            "type": "minecraft:model",
            "model": "minecraft:item/feather"
        },
        "cases": [
            {
                "when": "sword_1",
                "model": {
                    "type": "minecraft:model",
                    "model": "minecraft:item/sword_1"
                }
            },
            {
                "when": "short_sword_1",
                "model": {
                    "type": "minecraft:model",
                    "model": "minecraft:item/weapon/short_sword_1"
                }
            },
            {
                "when": "s.s.wood",
                "model": {
                    "type": "minecraft:model",
                    "model": "minecraft:item/weapon/s.s.wood"
                }
            },
            {
                "when": "s.s.stone",
                "model": {
                    "type": "minecraft:model",
                    "model": "minecraft:item/weapon/s.s.stone"
                }
            },
            {
                "when": "s.s.iron",
                "model": {
                    "type": "minecraft:model",
                    "model": "minecraft:item/weapon/s.s.iron"
                }
            },
            {
                "when": "s.s.gold",
                "model": {
                    "type": "minecraft:model",
                    "model": "minecraft:item/weapon/s.s.gold"
                }
            },
            {
                "when": "s.s.diamond",
                "model": {
                    "type": "minecraft:model",
                    "model": "minecraft:item/weapon/s.s.diamond"
                }
            },
            {
                "when": "s.s.netherite",
                "model": {
                    "type": "minecraft:model",
                    "model": "minecraft:item/weapon/s.s.netherite"
                }
            }
