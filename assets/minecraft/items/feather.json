{
    "model": {
        "type": "minecraft:select",
        "property": "minecraft:custom_model_data",
        "fallback": {
            "type": "minecraft:model",
            "model": "minecraft:item/feather"
        },
        "cases": [
            {
                "when": "sword_1",
                "model": {
                    "type": "minecraft:model",
                    "model": "minecraft:item/sword_1"
                }
            },
            {
                "when": "short_sword_1",
                "model": {
                    "type": "minecraft:model",
                    "model": "minecraft:item/weapon/short_sword_1"
                }
            }
        ]
    }
}
